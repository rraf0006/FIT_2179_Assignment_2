{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "autosize": {
    "type": "pad",
    "contains": "padding"
  },
  "width": 520,
  "height": 300,
  "title": {
    "text": "Highest incomes cluster around the Klang Valley",
    "subtitle": "Urban centres anchor Malaysia’s income divide."
  },
  "projection": {
    "type": "mercator",
    "center": [
      109.5,
      4
    ],
    "scale": 1550,
    "translate": [
      260,
      145
    ]
  },
  "data": {
    "url": "data/maps/malaysia-states.topojson",
    "format": {
      "type": "topojson",
      "feature": "states"
    }
  },
  "transform": [
    {
      "calculate": "datum.properties.Name == 'Pulau Pinang' ? 'Pulau Pinang' : datum.properties.Name == 'Penang' ? 'Pulau Pinang' : datum.properties.Name == 'Wilayah Persekutuan Labuan' ? 'Labuan' : datum.properties.Name == 'W.P. Labuan' ? 'Labuan' : datum.properties.Name == 'Wilayah Persekutuan Putrajaya' ? 'Putrajaya' : datum.properties.Name == 'W.P. Putrajaya' ? 'Putrajaya' : datum.properties.Name == 'Wilayah Persekutuan Kuala Lumpur' ? 'Kuala Lumpur' : datum.properties.Name == 'W.P. Kuala Lumpur' ? 'Kuala Lumpur' : datum.properties.Name",
      "as": "map_state_geo"
    },
    {
      "lookup": "map_state_geo",
      "from": {
        "data": {
          "url": "data/processed/state_2022.csv"
        },
        "key": "state_geo",
        "fields": [
          "state",
          "state_geo",
          "income_median",
          "income_mean",
          "poverty_absolute",
          "poverty_hardcore",
          "poverty_relative",
          "bivariate_class",
          "vulnerability_score",
          "vulnerability_group",
          "income_rank",
          "poverty_rank"
        ]
      }
    },
    {
      "calculate": "datum.income_median < 5000 ? 'Low (< RM5k)' : datum.income_median < 6500 ? 'Lower-middle (RM5k-6.5k)' : datum.income_median < 8500 ? 'Upper-middle (RM6.5k-8.5k)' : datum.income_median < 10000 ? 'High (RM8.5k-10k)' : 'Very high (RM10k+)'",
      "as": "income_class_label"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 0.9
      },
      "encoding": {
        "color": {
          "field": "income_class_label",
          "type": "ordinal",
          "title": "Median income class",
          "scale": {
            "domain": [
              "Low (< RM5k)",
              "Lower-middle (RM5k-6.5k)",
              "Upper-middle (RM6.5k-8.5k)",
              "High (RM8.5k-10k)",
              "Very high (RM10k+)"
            ],
            "range": [
              "#eaf2fb",
              "#cfe3f4",
              "#94bde1",
              "#4e88b9",
              "#175c8e"
            ]
          },
          "legend": {
            "orient": "bottom",
            "columns": 3,
            "labelLimit": 190
          }
        },
        "tooltip": [
          {
            "field": "state_geo",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "income_class_label",
            "type": "ordinal",
            "title": "Income class"
          },
          {
            "field": "income_median",
            "type": "quantitative",
            "title": "Median income (RM)",
            "format": ",.0f"
          },
          {
            "field": "income_mean",
            "type": "quantitative",
            "title": "Mean income (RM)",
            "format": ",.0f"
          },
          {
            "field": "poverty_absolute",
            "type": "quantitative",
            "title": "Absolute poverty (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "state_geo": "Kuala Lumpur",
            "lon": 101.69,
            "lat": 3.14
          }
        ]
      },
      "mark": {
        "type": "point",
        "filled": true,
        "size": 18,
        "color": "#111827",
        "opacity": 0.75
      },
      "encoding": {
        "longitude": {
          "field": "lon"
        },
        "latitude": {
          "field": "lat"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "state_geo": "Kuala Lumpur",
            "lon": 101.69,
            "lat": 3.14
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 10,
        "dx": 5,
        "dy": -5,
        "color": "#111827"
      },
      "encoding": {
        "longitude": {
          "field": "lon"
        },
        "latitude": {
          "field": "lat"
        },
        "text": {
          "field": "state_geo"
        }
      }
    }
  ],
  "config": {
    "font": "'IBM Plex Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "background": "transparent",
    "title": {
      "font": "'IBM Plex Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "fontSize": 19,
      "fontWeight": 700,
      "lineHeight": 23,
      "subtitleFont": "'IBM Plex Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "subtitleFontSize": 14,
      "subtitleColor": "#5b6472",
      "subtitleLineHeight": 19,
      "subtitlePadding": 8,
      "offset": 20,
      "anchor": "start",
      "color": "#111827"
    },
    "axis": {
      "labelFont": "'IBM Plex Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "titleFont": "'IBM Plex Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#111827",
      "titleColor": "#111827",
      "gridColor": "#eef2f6",
      "domainColor": "#e5e7eb",
      "tickColor": "#e5e7eb"
    },
    "legend": {
      "labelFont": "'IBM Plex Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "titleFont": "'IBM Plex Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelColor": "#111827",
      "titleColor": "#111827",
      "orient": "right"
    },
    "view": {
      "stroke": null
    }
  }
}
