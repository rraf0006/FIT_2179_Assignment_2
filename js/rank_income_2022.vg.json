{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 420,
  "data": {
    "url": "data/processed/state_2022.csv"
  },
  "title": {
    "text": "The income gap is clearer when states are ranked",
    "subtitle": "Ranked bars support exact comparison where maps are harder to read."
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3
      },
      "encoding": {
        "x": {
          "field": "income_median",
          "type": "quantitative",
          "title": "Median income (RM/month)",
          "axis": {
            "labelExpr": "format(datum.value, ',.0f')",
            "tickCount": 6
          }
        },
        "y": {
          "field": "state_geo",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "income_median",
            "order": "descending"
          }
        },
        "color": {
          "condition": {
            "test": "datum.highlight_income",
            "value": "#1f4e79"
          },
          "value": "#d8dee8"
        },
        "tooltip": [
          {
            "field": "income_rank",
            "type": "quantitative",
            "title": "Income rank"
          },
          {
            "field": "state_geo",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "income_median",
            "type": "quantitative",
            "title": "Median income (RM)",
            "format": ","
          },
          {
            "field": "poverty_absolute",
            "type": "quantitative",
            "title": "Absolute poverty (%)",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "config": {
    "font": "'IBM Plex Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "background": "transparent",
    "title": {
      "font": "'IBM Plex Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "fontSize": 19,
      "fontWeight": 700,
      "lineHeight": 23,
      "subtitleFont": "'IBM Plex Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "subtitleFontSize": 14,
      "subtitleColor": "#5b6472",
      "subtitleLineHeight": 19,
      "subtitlePadding": 8,
      "offset": 20,
      "anchor": "start",
      "color": "#111827"
    },
    "axis": {
      "labelFont": "'IBM Plex Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "titleFont": "'IBM Plex Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#111827",
      "titleColor": "#111827",
      "gridColor": "#eef2f6",
      "domainColor": "#e5e7eb",
      "tickColor": "#e5e7eb"
    },
    "legend": {
      "labelFont": "'IBM Plex Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "titleFont": "'IBM Plex Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelColor": "#111827",
      "titleColor": "#111827",
      "orient": "right"
    },
    "view": {
      "stroke": null
    }
  }
}
