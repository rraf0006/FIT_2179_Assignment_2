{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 440,
  "data": {
    "url": "data/processed/state_income_poverty.csv"
  },
  "title": {
    "text": "Progress has not removed the poverty gap",
    "subtitle": "The colour pattern shows which states experienced persistent poverty pressure."
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 0.5
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": "Survey year"
        },
        "y": {
          "field": "state_geo",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "vulnerability_order",
            "op": "min",
            "order": "ascending"
          }
        },
        "color": {
          "field": "poverty_absolute",
          "type": "quantitative",
          "title": "Absolute poverty (%)",
          "scale": {
            "range": [
              "#f8f2f6",
              "#ead8e4",
              "#c99ab7",
              "#96557b",
              "#5e2549"
            ]
          }
        },
        "tooltip": [
          {
            "field": "state_geo",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "poverty_absolute",
            "type": "quantitative",
            "title": "Absolute poverty (%)",
            "format": ".1f"
          },
          {
            "field": "income_median",
            "type": "quantitative",
            "title": "Median income (RM)",
            "format": ",.0f"
          },
          {
            "field": "vulnerability_group",
            "type": "nominal",
            "title": "2022 group"
          }
        ]
      }
    }
  ],
  "config": {
    "font": "'IBM Plex Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "background": "transparent",
    "title": {
      "font": "'IBM Plex Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "fontSize": 19,
      "fontWeight": 700,
      "lineHeight": 23,
      "subtitleFont": "'IBM Plex Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "subtitleFontSize": 14,
      "subtitleColor": "#5b6472",
      "subtitleLineHeight": 19,
      "subtitlePadding": 8,
      "offset": 20,
      "anchor": "start",
      "color": "#111827"
    },
    "axis": {
      "labelFont": "'IBM Plex Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "titleFont": "'IBM Plex Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#111827",
      "titleColor": "#111827",
      "gridColor": "#eef2f6",
      "domainColor": "#e5e7eb",
      "tickColor": "#e5e7eb"
    },
    "legend": {
      "labelFont": "'IBM Plex Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "titleFont": "'IBM Plex Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelColor": "#111827",
      "titleColor": "#111827",
      "orient": "right"
    },
    "view": {
      "stroke": null
    }
  }
}
