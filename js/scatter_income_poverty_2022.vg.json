{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 470,
  "data": {
    "url": "data/processed/state_2022.csv"
  },
  "title": {
    "text": "Lower-income states tend to face higher absolute poverty",
    "subtitle": "Bubble size shows relative poverty; hover a state for details"
  },
  "layer": [
    {
      "mark": {
        "type": "circle",
        "filled": true,
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "income_median",
          "type": "quantitative",
          "title": "Median income (RM/month)",
          "axis": {
            "format": ","
          }
        },
        "y": {
          "field": "poverty_absolute",
          "type": "quantitative",
          "title": "Absolute poverty (%)",
          "scale": {
            "zero": true
          }
        },
        "size": {
          "field": "poverty_relative",
          "type": "quantitative",
          "title": "Relative poverty (%)",
          "scale": {
            "range": [
              80,
              800
            ]
          }
        },
        "color": {
          "field": "vulnerability_group",
          "type": "nominal",
          "title": "2022 scorecard group",
          "scale": {
            "domain": [
              "Highest vulnerability",
              "Watch closely",
              "Lower vulnerability"
            ],
            "range": [
              "#7b3294",
              "#d8a21b",
              "#1f78b4"
            ]
          }
        },
        "opacity": {
          "value": 0.82
        },
        "tooltip": [
          {
            "field": "state_geo",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "income_median",
            "type": "quantitative",
            "title": "Median income (RM)",
            "format": ","
          },
          {
            "field": "poverty_absolute",
            "type": "quantitative",
            "title": "Absolute poverty (%)",
            "format": ".1f"
          },
          {
            "field": "poverty_relative",
            "type": "quantitative",
            "title": "Relative poverty (%)",
            "format": ".1f"
          },
          {
            "field": "vulnerability_group",
            "type": "nominal",
            "title": "Scorecard group"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.label_scatter"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 9,
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#1f2933"
      },
      "encoding": {
        "x": {
          "field": "income_median",
          "type": "quantitative"
        },
        "y": {
          "field": "poverty_absolute",
          "type": "quantitative"
        },
        "text": {
          "field": "state_geo",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "font": "Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "background": "transparent",
    "title": {
      "font": "Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "fontSize": 17,
      "fontWeight": 700,
      "subtitleFont": "Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "subtitleFontSize": 12,
      "subtitleColor": "#6b7280",
      "anchor": "start",
      "color": "#1f2933"
    },
    "axis": {
      "labelFont": "Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "titleFont": "Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelColor": "#1f2933",
      "titleColor": "#1f2933",
      "gridColor": "#ece7df",
      "domainColor": "#e6ded3",
      "tickColor": "#e6ded3"
    },
    "legend": {
      "labelFont": "Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "titleFont": "Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelColor": "#1f2933",
      "titleColor": "#1f2933",
      "orient": "right"
    },
    "view": {
      "stroke": null
    }
  }
}
