{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "width": "container",
  "height": 350,
  "title": {
    "text": "Poverty remains concentrated in several states",
    "subtitle": "The highest rates appear outside Malaysia's strongest income centres."
  },
  "projection": {
    "type": "azimuthalEqualArea",
    "center": [
      109.5,
      4
    ]
  },
  "data": {
    "url": "data/maps/malaysia-states.topojson",
    "format": {
      "type": "topojson",
      "feature": "states"
    }
  },
  "transform": [
    {
      "calculate": "datum.properties.Name == 'Pulau Pinang' ? 'Pulau Pinang' : datum.properties.Name == 'Penang' ? 'Pulau Pinang' : datum.properties.Name == 'Wilayah Persekutuan Labuan' ? 'Labuan' : datum.properties.Name == 'W.P. Labuan' ? 'Labuan' : datum.properties.Name == 'Wilayah Persekutuan Putrajaya' ? 'Putrajaya' : datum.properties.Name == 'W.P. Putrajaya' ? 'Putrajaya' : datum.properties.Name == 'Wilayah Persekutuan Kuala Lumpur' ? 'Kuala Lumpur' : datum.properties.Name == 'W.P. Kuala Lumpur' ? 'Kuala Lumpur' : datum.properties.Name",
      "as": "map_state_geo"
    },
    {
      "lookup": "map_state_geo",
      "from": {
        "data": {
          "url": "data/processed/state_2022.csv"
        },
        "key": "state_geo",
        "fields": [
          "state",
          "state_geo",
          "income_median",
          "income_mean",
          "poverty_absolute",
          "poverty_hardcore",
          "poverty_relative",
          "bivariate_class",
          "vulnerability_score",
          "vulnerability_group",
          "income_rank",
          "poverty_rank"
        ]
      }
    },
    {
      "calculate": "datum.poverty_absolute < 2 ? 'Very low (0-2%)' : datum.poverty_absolute < 5 ? 'Low (2-5%)' : datum.poverty_absolute < 10 ? 'Moderate (5-10%)' : datum.poverty_absolute < 15 ? 'High (10-15%)' : 'Very high (15%+)'",
      "as": "poverty_class_label"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 0.9
      },
      "encoding": {
        "color": {
          "field": "poverty_class_label",
          "type": "ordinal",
          "title": "Absolute poverty class",
          "scale": {
            "domain": [
              "Very low (0-2%)",
              "Low (2-5%)",
              "Moderate (5-10%)",
              "High (10-15%)",
              "Very high (15%+)"
            ],
            "range": [
              "#f8f2f6",
              "#ead8e4",
              "#c99ab7",
              "#96557b",
              "#5e2549"
            ]
          },
          "legend": {
            "orient": "bottom",
            "columns": 3,
            "labelLimit": 175
          }
        },
        "tooltip": [
          {
            "field": "state_geo",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "poverty_class_label",
            "type": "ordinal",
            "title": "Poverty class"
          },
          {
            "field": "poverty_absolute",
            "type": "quantitative",
            "title": "Absolute poverty (%)",
            "format": ".1f"
          },
          {
            "field": "poverty_relative",
            "type": "quantitative",
            "title": "Relative poverty (%)",
            "format": ".1f"
          },
          {
            "field": "income_median",
            "type": "quantitative",
            "title": "Median income (RM)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "state_geo": "Kuala Lumpur",
            "lon": 101.69,
            "lat": 3.14
          }
        ]
      },
      "mark": {
        "type": "point",
        "filled": true,
        "size": 18,
        "color": "#111827",
        "opacity": 0.75
      },
      "encoding": {
        "longitude": {
          "field": "lon"
        },
        "latitude": {
          "field": "lat"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "state_geo": "Kuala Lumpur",
            "lon": 101.69,
            "lat": 3.14
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 10,
        "dx": 5,
        "dy": -5,
        "color": "#111827"
      },
      "encoding": {
        "longitude": {
          "field": "lon"
        },
        "latitude": {
          "field": "lat"
        },
        "text": {
          "field": "state_geo"
        }
      }
    }
  ],
  "config": {
    "font": "'IBM Plex Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "background": "transparent",
    "title": {
      "font": "'IBM Plex Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "fontSize": 19,
      "fontWeight": 700,
      "lineHeight": 23,
      "subtitleFont": "'IBM Plex Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "subtitleFontSize": 14,
      "subtitleColor": "#5b6472",
      "subtitleLineHeight": 19,
      "subtitlePadding": 8,
      "offset": 20,
      "anchor": "start",
      "color": "#111827"
    },
    "axis": {
      "labelFont": "'IBM Plex Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "titleFont": "'IBM Plex Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#111827",
      "titleColor": "#111827",
      "gridColor": "#eef2f6",
      "domainColor": "#e5e7eb",
      "tickColor": "#e5e7eb"
    },
    "legend": {
      "labelFont": "'IBM Plex Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "titleFont": "'IBM Plex Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "labelColor": "#111827",
      "titleColor": "#111827",
      "orient": "right"
    },
    "view": {
      "stroke": null
    }
  }
}
